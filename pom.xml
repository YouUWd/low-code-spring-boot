                <version>${jackson.version}</version>
            </dependency>
            <!-- OSS SDK (AWS SDK Java V2) -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>s3</artifactId>
                <version>2.27.21</version>
            </dependency>
            <!-- jOOQ -->
            <dependency>
                <groupId>org.jooq</groupId>
                <artifactId>jooq</artifactId>
