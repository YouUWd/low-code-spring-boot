         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.jdec</groupId>
    <artifactId>jdec-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>JDEC Platform</name>
    <description>JDEC 企业级模块化平台 — 基于 Spring Modulith</description>

    <modules>
        <module>jdec-platform-shared</module>
        <module>jdec-platform-auth-api</module>
        <module>jdec-platform-auth-biz</module>
        <module>jdec-platform-config-api</module>
        <module>jdec-platform-config-biz</module>
        <module>jdec-platform-hr-api</module>
        <module>jdec-platform-hr-biz</module>
        <module>jdec-platform-data-api</module>
        <module>jdec-platform-data-biz</module>
        <module>jdec-platform-school-api</module>
        <module>jdec-platform-school-biz</module>
        <module>jdec-platform-app</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>21</java.version>
        <spring-modulith.version>1.4.10</spring-modulith.version>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
        <knife4j.version>4.4.0</knife4j.version>
        <jackson.version>2.18.2</jackson.version>
        <jooq.version>3.19.15</jooq.version>
    </properties>
    <!-- 配置云效私服仓库 -->
    <repositories>
        <repository>
            <id>repo-jqily</id>
            <url>https://packages.aliyun.com/69b28dc14a29923eb360faa3/maven/repo-jqily</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
    <!-- ==================== 版本管理 ==================== -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Modulith BOM -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 子模块版本管理 -->
            <dependency>
                <groupId>com.jdec</groupId>
                <artifactId>jdec-platform-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jdec</groupId>
                <artifactId>jdec-platform-auth-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jdec</groupId>
                <artifactId>jdec-platform-auth-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jdec</groupId>
                <artifactId>jdec-platform-config-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jdec</groupId>
                <artifactId>jdec-platform-config-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jdec</groupId>
                <artifactId>jdec-platform-hr-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jdec</groupId>
                <artifactId>jdec-platform-hr-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jdec</groupId>
                <artifactId>jdec-platform-data-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jdec</groupId>
                <artifactId>jdec-platform-data-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jdec</groupId>
                <artifactId>jdec-platform-school-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jdec</groupId>
                <artifactId>jdec-platform-school-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jdec</groupId>
                <artifactId>jdec-platform-common-business-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jdec</groupId>
                <artifactId>jdec-platform-common-business-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jdec</groupId>
